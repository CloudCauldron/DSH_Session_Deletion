{
  "name": "dsh-session-deletion",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Immediate session deletion and orphan attachment cleanup for DSH.",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p test/tsconfig.json",
    "test": "pnpm build && node --test test/*.test.ts",
    "test:integration": "pnpm build && node test/integration.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "koffi": "3.1.1"
  },
  "files": [
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
