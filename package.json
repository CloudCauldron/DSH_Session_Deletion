{
  "name": "dsh-session-deletion",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Immediate private session deletion and separately guarded orphan attachment garbage collection for DSH.",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./lib/host.js",
    "./gate": "./lib/gate.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./runtime": "./lib/runtime.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "test:integration": "pnpm build && node test/integration.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "koffi": "3.1.1"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
